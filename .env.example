# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# InsForge (auth + database)
# Anon key: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=https://your-project.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key

# AI agents: any OpenAI-compatible endpoint. Defaults to local Ollama (ollama pull qwen2.5-coder:7b).
# For OpenAI use AI_BASE_URL=https://api.openai.com/v1, AI_API_KEY=sk-..., AI_MODEL=gpt-4.1-mini
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5-coder:7b

# Server-side admin key for background jobs (Inngest): npx @insforge/cli secrets get API_KEY
INSFORGE_API_KEY=

# Agent computers: the Research and Creator agents each get a cloud Linux desktop (https://e2b.dev)
E2B_API_KEY=
# Computer agents read screenshots, so they need a vision model on the same AI endpoint
# (e.g. gpt-4.1-mini on OpenAI, qwen3.5:4b or qwen2.5vl on Ollama). Defaults to AI_MODEL.
COMPUTER_MODEL=
# Optional: a different OpenAI-compatible endpoint for the computer agents only. Free and fast option:
# COMPUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# COMPUTER_API_KEY=<your GEMINI_API_KEY>  with  COMPUTER_MODEL=gemini-3.1-flash-lite
COMPUTER_BASE_URL=
COMPUTER_API_KEY=
# Optional: used for a call when COMPUTER_MODEL is overloaded (503/429) or times out, e.g. gemini-3.5-flash.
# COMPUTER_FALLBACK_BASE_URL defaults to COMPUTER_BASE_URL.
COMPUTER_FALLBACK_MODEL=

# Text web search for the Research and Creator agents (quick_search): one API call instead of many
# browser screenshots. Set at least one key; SEARCH_PROVIDER picks the first to try (tavily, firecrawl,
# brave, serper or gemini). Without a key the agents use the browser only.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Firecrawl (https://firecrawl.dev, free monthly credits): a search provider, and read_page reads articles
# through it in seconds without starting the agent's desktop. It refuses social networks.
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Gemini with Google Search grounding (uses GEMINI_API_KEY). Off unless set: free keys usually have no quota for it.
# GEMINI_SEARCH_MODEL=gemini-3.5-flash

# Creator Agent images. IMAGE_PROVIDER picks the first to try: gemini (default), cloudflare, openai
# or imagekit; the others are fallbacks when their keys are set. OpenAI uses OPENAI_API_KEY.
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
# Cloudflare Workers AI (FLUX.1 schnell), free daily allowance: account id + API token with Workers AI access
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=

# ImageKit: permanent URLs for agents' files and AI image edits (background removal, upscale, ...)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Blotato: each user pastes their own Blotato API key in Settings → Integrations. Keys are stored
# encrypted with this 32-byte key (base64). Generate one with: openssl rand -base64 32
# Changing it makes saved keys unreadable, so users would have to paste them again.
INTEGRATIONS_ENCRYPTION_KEY=

# Zernio (https://zernio.com): the main way to publish and to answer comments/DMs. The app holds one
# key and gives each user their own Zernio profile, so users connect accounts without signing up.
# First 2 connected accounts are free, then billed per account. Create at zernio.com/dashboard/api-keys
ZERNIO_API_KEY=
