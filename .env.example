# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# InsForge (auth + database)
# Anon key: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=https://your-project.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key

# AI agents: any OpenAI-compatible endpoint. Defaults to local Ollama (ollama pull qwen2.5-coder:7b).
# For OpenAI use AI_BASE_URL=https://api.openai.com/v1, AI_API_KEY=sk-..., AI_MODEL=gpt-4.1-mini
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5-coder:7b

# Server-side admin key for background jobs (Inngest): npx @insforge/cli secrets get API_KEY
INSFORGE_API_KEY=

# Agent computers: the Research and Creator agents each get a cloud Linux desktop (https://e2b.dev)
E2B_API_KEY=
# Computer agents read screenshots, so they need a vision model on the same AI endpoint
# (e.g. gpt-4.1-mini on OpenAI, qwen3.5:4b or qwen2.5vl on Ollama). Defaults to AI_MODEL.
COMPUTER_MODEL=

# Creator Agent images. IMAGE_PROVIDER picks the first to try: gemini (default), openai or imagekit;
# the others are fallbacks when their keys are set. OpenAI uses OPENAI_API_KEY.
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ImageKit: permanent URLs for agents' files and AI image edits (background removal, upscale, ...)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
